###############################################################################
# SnakePop configuration
###############################################################################

###############################################################################
# Reference genome
###############################################################################

ref:
  # Short name used in output paths.
  name: GCA_054643105.1_CIBA_Cheb_1.1

  # Original downloaded reference FASTA.
  original_fasta: /scratch/antwerpen/grp/asvardal/projects/clingfishes/parastromatus/reference/ncbi_dataset/data/GCA_054643105.1/GCA_054643105.1_CIBA_Cheb_1.1_genomic.fna

  # NCBI assembly report used for chromosome/scaffold renaming.
  assembly_report: /scratch/antwerpen/grp/asvardal/projects/clingfishes/parastromatus/reference/ncbi_dataset/data/GCA_054643105.1/sequence_report.tsv

  # Final reference FASTA used by SnakePop.
  fasta: /scratch/antwerpen/grp/asvardal/projects/clingfishes/parastromatus/reference/ncbi_dataset/data/GCA_054643105.1/GCA_054643105.1_CIBA_Cheb_1.1_genomic_chromnames.fna

  species: Caranx heberi

  # Prefix used when renaming chromosomes.
  chrom_prefix: chr

  # Name assigned to the mitochondrial scaffold/chromosome.
  mt_name: mtDNA


###############################################################################
# Samples and callset
###############################################################################

sample_table: config/Metadata_parastromatus_no_GJ01.tsv 

# Column in the metadata table containing sample IDs.
sample_id_column: sample_id

# Column containing paths to read files.
read_files_column: read_files

callset:
  # Identifier used in output directories.
  id: GCA_054643105.1_CIBA_Cheb_1.1 


###############################################################################
# Variant calling and filtering
###############################################################################

variant_calling:
  # Genomic chunk size for variant calling.
  chunk_size: 5000000

  # Maximum total depth used during filtering.
  max_depth: 3000

  # Names of the filter sets defined below.
  ind_filter_id: tif1
  site_filter_id: sft1

  # If false, temporary files are removed where possible.
  keep_intermediates: false


###############################################################################
# Computational resources
###############################################################################

resources:

  rename_reference:
    threads: 1
    mem_mb: 4000
    walltime: 1

  bwa_index:
    threads: 8
    mem_mb: 8000
    walltime: 4

  align_reads:
    threads: 8
    mem_mb: 18000
    walltime: 48

  flagstat:
    threads: 1
    mem_mb: 4000
    walltime: 1

  call_all_sites_bcf:
    threads: 2
    mem_mb: 18000
    walltime: 24

  genotype_filter_all_sites:
    threads: 1
    mem_mb: 36000
    walltime: 12

  add_site_filters:
    threads: 1
    mem_mb: 8000
    walltime: 4

  make_chrom_all_sites:
    threads: 1
    mem_mb: 12000
    walltime: 8

  make_chrom_variants:
    threads: 1
    mem_mb: 8000
    walltime: 4

  make_chrom_biallelic_snps:
    threads: 1
    mem_mb: 8000
    walltime: 4

  pca:
    threads: 8
    mem_mb: 32000
    walltime: 8

  popgenwindows:
    threads: 8
    mem_mb: 16000
    walltime: 2

  parse_vcf:
    threads: 1
    mem_mb: 4000
    walltime: 2

  roh:
    threads: 1
    mem_mb: 8000
    walltime: 4
  
  watterson_theta:
    threads: 1
    mem_mb: 8000
    walltime: 6

  winpca:
    threads: 4
    mem_mb: 16000
    walltime: 4

  snptrees_iqtree:
    threads: 4
    mem_mb: 16000
    walltime: 24

  dsuite:
    threads: 1
    mem_mb: 16000
    walltime: 24

  twisst:
    threads: 1
    mem_mb: 8000
    walltime: 8

  sfs:
    threads: 1
    mem_mb: 8000
    walltime: 6


###############################################################################
# Individual-level genotype filters
###############################################################################

individual_filter_sets:

  tif1:
    # Allele-balance test threshold.
    ab_test_thresh: 0.01

    # Minimum genotype quality.
    min_GQ: 10

    # Genotypes with extreme depth can be set to missing.
    max_dp_to_missing_pval: 1.0e-2
    min_dp_to_missing_pval: 0


###############################################################################
# Site-level filters
###############################################################################

site_filter_sets:

  sft1:
    # Merge nearby filtered sites within this distance.
    merge_dist: 10

    filters:

      LowMQ:
        tag: MQ
        threshold: 50
        threshold_type: absolute
        operator: "<"

      ExcessMQ0:
        tag: MQ0F
        threshold: 0.1
        threshold_type: absolute
        operator: ">"

      StrandBias:
        tag: MQSBZ
        threshold: 1.0e-3
        threshold_type: absolute
        operator: "<"
        description: Highly significant Mann-Whitney U test of Mapping Quality vs Strand Bias.

      ExcessHet:
        tag: ExcHetOrig
        threshold: 0.2
        threshold_type: absolute
        operator: "<"

      AlleleBalance:
        tag: AB_Het
        threshold: 20
        threshold_type: absolute
        operator: ">"

      DepthDeviation:
        tag: DD
        threshold: 2
        threshold_type: absolute
        operator: ">"

      ExcessMissing:
        tag: MF
        threshold: 0.2
        threshold_type: absolute
        operator: ">"


###############################################################################
# Population-genomic analyses
###############################################################################

popstats:

  # Default metadata column used to define populations/groups.
  population_column: group


  ###########################################################################
  # PCA
  ###########################################################################

  pca:
    n_pcs: 10
    maf: 0.05
    mind: 0.2
    geno: 0.2

    # Metadata column used for colouring samples.
    color_by: group

    label_samples: true

    # If true, PCA is run on LD-pruned SNPs.
    ld_prune: false

    # PLINK chromosome setting.
    plink_chr_set: 23 no-xy no-mt

    indep_pairwise:
      window_kb: 50
      step: 5
      r2: 0.2


  ###########################################################################
  # Windowed population statistics
  ###########################################################################

  popgenwindows:
    enabled: true

    # Window size and step in bp.
    window_size: 60000
    window_step: 30000

    # Minimum number of sites required per window.
    window_min_sites: 100

    # Use phased or unphased genotype input.
    input_format: phased


  ###########################################################################
  # Manhattan-style genome scans
  ###########################################################################

  manhattan:
    enabled: false

    # If true, candidate regions are compared with WinPCA output.
    compare_winpca: true

    # Pairwise population comparisons.
    pairs:
      - pop1: GJ
        pop2: PEKM

    # Statistics to plot.
    metrics:
      - Fst
      - dxy
      - dA

    # Add pi panels for both populations.
    include_pi: true

    # Quantile used to define outlier windows.
    outlier_quantile: 0.995

    ylim:
      Fst: [-0.1, 0.6]
      dxy: [0, null]
      dA: [0, null]
      pi: [0, null]

    colors:
      GJ: "#4E79A7"
      PEKM: "#F28E2B"
      PTN: "#59A14F"
      S: "#B07AA1"

    candidate_regions:
      # Statistic used to merge outlier windows into candidate regions.
      primary_metric: Fst

      # Merge outlier windows separated by <= this distance.
      merge_gap_bp: 30000

      # Minimum number of outlier windows required.
      min_windows: 2


  ###########################################################################
  # Heterozygosity
  ###########################################################################

  heterozygosity:
    enabled: true
    color_by: group


  ###########################################################################
  # Runs of homozygosity
  ###########################################################################

  roh:
    enabled: true
    color_by: group

    min_kb: 500
    min_snp: 100
    density_kb_per_snp: 50
    max_gap_kb: 1000

    window_snp: 50
    window_het: 1
    window_missing: 5
    window_threshold: 0.05

    length_classes:
      short: [500, 1000]
      medium: [1000, 2000]
      long: [2000, 5000]
      very_long: [5000, null]


  ###########################################################################
  # Windowed PCA
  ###########################################################################

  winpca:
    enabled: true

    # Install from: https://github.com/MoritzBlumer/winpca.git
    executable: bin/winpca/winpca

    window_size: 500000
    increment: 10000
    min_maf: 0.01

    color_by: group

    plot_var: 1
    plot_interval: 5

    # SVG requires Chrome; HTML is safest.
    plot_format: HTML

    # Optional sample subset.
    sample_filter:
      column: null
      values: []


  ###########################################################################
  # Windowed SNP trees with IQ-TREE
  ###########################################################################

  snptrees_iqtree:
    enabled: true

    vcf2phylip: bin/vcf2phylip/vcf2phylip.py
    iqtree: iqtree

    window_size: 1000000
    increment: 1000000
    min_snps: 500

    model: GTR
    fast: true
    UFBoots: 0

    cleanup: true
    tmpdir: /tmp/vsc20570

    sample_filter:
      ids: []
      column: null
      values: []


  ###########################################################################
  # ASTRAL species tree
  ###########################################################################

  astral:
    enabled: false
    executable: astral

    # 1 = quartet support
    # 2 = full annotation
    # 3 = posterior probability/default
    branch_annotate: 2

    mapping_column: group

    root:
      enabled: true
      outgroups: []


  ###########################################################################
  # Dsuite introgression tests
  ###########################################################################

  dsuite:
    enabled: false

    executable: bin/Dsuite/Build/Dsuite
    mapping_column: group

    outgroups: []

    tree: results/popstats/GCA_054643105.1_CIBA_Cheb_1.1_24072026_GCA_054643105.1_CIBA_Cheb_1.1/astral/astral.topology.tree

    jknum: 20
    no_f4_ratio: false
    abba_clustering: false


  ###########################################################################
  # TWISST topology weighting
  ###########################################################################

  twisst:
    enabled: false

    executable: bin/twisst/twisst.py
    mapping_column: group

    # Optional outgroup used by TWISST.
    # null means no explicit outgroup.
    outgroup: null

    # complete or fixed.
    method: complete

    # Used only for method: fixed.
    iterations: 100

    abort_cutoff: 100

    plotting:
      enabled: true
      script: bin/plot_twisst_snakepop.R

      width: 14
      height: 8

      formats:
        - pdf
        - svg
        - png

      # Number of highest-weighted topologies to show in top-N plots.
      top_n: 6

      # Rolling smoothing window for genome-wide plots.
      smooth_k: 15


  ###########################################################################
  # Site Frequency Spectrum
  ###########################################################################

  sfs:
    enabled: false

    # Metadata column defining populations.
    population_column: group

    populations:
      # Populations to include.
      #
      # all
      #   -> every population present in the metadata.
      #
      # list
      #   -> only the specified populations.
      include: all

      # Example:
      # include:
      #   - morph_1
      #   - morph_2
      #   - minutus

    polarisation:
      # folded
      #   -> minor allele frequency spectrum.
      #      Does not require ancestral-state information.
      #
      # unfolded
      #   -> derived allele frequency spectrum.
      #      Requires one or more outgroups.
      mode: folded

      # Only used for unfolded SFS.
      outgroups: []

    spectra:
      one_d:
        # Calculates one SFS for every included population.
        enabled: true

      two_d:
        enabled: true

        # Pairwise joint SFS comparisons.
        #
        # all
        #   -> every pairwise comparison among included populations.
        #
        # list
        #   -> only the explicitly listed pairs.
        #comparisons: all

        # Example:
        comparisons:
           - [GJ, PEKM]
        #   - [morph_1, minutus]

    regions:
      # SFS across all SNPs.
      genome: true

      # SFS restricted to FST outlier windows from the Manhattan module.
      outlier_windows: true

      # SFS restricted to merged candidate regions from the Manhattan module.
      candidate_regions: true

      # Optional user-defined BED/GFF/gene regions.
      custom_regions:
        enabled: false
        source: bed
        file: null

    plotting:
      enabled: true

      formats:
        - pdf
        - svg
        - png

  ###########################################################################
  # Watterson's theta
  ###########################################################################
  watterson_theta:
    enabled: true

    # Metadata column defining populations.
    # If omitted, popstats.population_column is used.
    population_column: morphology

    populations:
      # all -> calculate theta_W for every population in the metadata.
      include: all

      # Alternatively:
      # include:
      #   - morph_1
      #   - morph_2
      #   - minutus

    # Genomic windows in bp.
    window_size: 60000
    window_step: 30000

    # Expected organism ploidy.
    ploidy: 2

    # A site is considered callable for a population when at least this
    # fraction of its chromosomes have genotype calls.
    min_called_fraction: 0.8

    # Windows with fewer callable sites get theta_w = NA.
    min_callable_sites: 1000

    # Exclude indels and other non-SNP variant positions.
    # Invariant nucleotide positions remain in the denominator.
    snps_only: true

    # Analysis script.
    script: bin/watterson_theta_snakepop.py
