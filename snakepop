#!/usr/bin/env bash

set -euo pipefail

CONFIG="config/config.yaml"
CORES=""
PROFILE=""
DRYRUN=()
SNAKEMAKE_ARGS=()
TARGET=""

usage() {
    cat <<'EOF'
                    /^\/^\
                   _|__|  O|
          \/     /~     \_/ \
           \____|__________/  \
                  \_______     \
                          `\    \
                            |    |
                           /    /
                          /    /
                        /    /
                      /    /      SnakePop v1
                     |    |                      ~~
                     |    |                     /*/
                      \    \                   /*/
                       \    \______________---/*/
                        \                   _/*/
                         \_______________--'

                           ~~~ SSSSSSSSS ~~~

Usage:
  ./snakepop <target> --cores N [options]

Core workflow:
  alignment             Map reads to the reference genome
  raw_calling           Generate raw variant calls
  filtering             Apply genotype and site filters
  final_callset         Build final VCF callsets
  variants              Run raw_calling, filtering, and final_callset
  all                   Run the complete workflow

Population analyses:
  pca
  popgenwindows
  watterson_theta
  heterozygosity
  roh
  winpca
  snptrees_iqtree
  astral
  dsuite
  twisst
  sfs
  popstats

Cleanup:
  clean_intermediates
  clean_snakemake

Options:
  --cores N             Number of Snakemake cores
  --config FILE         Configuration file
                        Default: config/config.yaml
  --profile PROFILE     Snakemake profile
  -n, --dry-run         Perform a dry run
  --snakemake ARG       Pass one additional argument to Snakemake
  -h, --help            Show this help
EOF
}

if [[ $# -eq 0 ]]; then
    usage
    exit 1
fi

case "$1" in
    alignment|raw_calling|filtering|final_callset|variants|all|\
    pca|popgenwindows|watterson_theta|heterozygosity|roh|winpca|sfs|\
    snptrees_iqtree|astral|dsuite|twisst|\
    clean_intermediates|clean_snakemake)
        TARGET="$1"
        shift
        ;;

    -h|--help)
        usage
        exit 0
        ;;

    *)
        echo "ERROR: Unknown target '$1'" >&2
        echo >&2
        usage >&2
        exit 1
        ;;
esac

while [[ $# -gt 0 ]]; do
    case "$1" in
        --cores)
            if [[ $# -lt 2 || -z "${2:-}" ]]; then
                echo "ERROR: --cores requires a value" >&2
                exit 1
            fi
            CORES="$2"
            shift 2
            ;;

        --config)
            if [[ $# -lt 2 || -z "${2:-}" ]]; then
                echo "ERROR: --config requires a file path" >&2
                exit 1
            fi
            CONFIG="$2"
            shift 2
            ;;

        --profile)
            if [[ $# -lt 2 || -z "${2:-}" ]]; then
                echo "ERROR: --profile requires a value" >&2
                exit 1
            fi
            PROFILE="$2"
            shift 2
            ;;

        -n|--dry-run)
            DRYRUN=(-n -p)
            shift
            ;;

        --snakemake)
            if [[ $# -lt 2 || -z "${2:-}" ]]; then
                echo "ERROR: --snakemake requires an argument" >&2
                exit 1
            fi
            SNAKEMAKE_ARGS+=("$2")
            shift 2
            ;;

        --)
            shift
            SNAKEMAKE_ARGS+=("$@")
            break
            ;;

        *)
            echo "ERROR: Unknown option '$1'" >&2
            echo >&2
            usage >&2
            exit 1
            ;;
    esac
done

if [[ -z "$CORES" ]]; then
    echo "ERROR: --cores is required" >&2
    echo >&2
    usage >&2
    exit 1
fi

if [[ ! "$CORES" =~ ^[1-9][0-9]*$ ]]; then
    echo "ERROR: --cores must be a positive integer" >&2
    exit 1
fi

if [[ ! -f "$CONFIG" ]]; then
    echo "ERROR: Config file not found: $CONFIG" >&2
    exit 1
fi

if [[ ! -f workflow/Snakefile ]]; then
    echo "ERROR: workflow/Snakefile not found" >&2
    exit 1
fi

CMD=(
    snakemake
    --snakefile workflow/Snakefile
    --configfile "$CONFIG"
    --cores "$CORES"
)

if [[ -n "$PROFILE" ]]; then
    CMD+=(--profile "$PROFILE")
fi

CMD+=("${DRYRUN[@]}")
CMD+=("${SNAKEMAKE_ARGS[@]}")
CMD+=("$TARGET")

echo
echo "Running:"
printf '%q ' "${CMD[@]}"
echo
echo

"${CMD[@]}"
